#
# LEGACY nslcd.conf - DO NOT USE ON AlmaLinux 10 / EL10 unless you built nslcd yourself.
#
# nss-pam-ldapd (nslcd) was removed from RHEL 8+ / AlmaLinux 8+ per Red Hat guidance.
# The supported path on AlmaLinux 10 is SSSD + sssd-nfs-idmap.
#
# This file is provided only for non-EL10 environments or as historical reference.
#
# If you really need this path, you must install nss-pam-ldapd from source or third-party repos
# and accept the maintenance burden.
#

uid nslcd
gid ldap

# LLDAP
uri ldaps://lldap.example.com:6360
base dc=example,dc=com

# TLS
ssl on
tls_reqcert demand
# tls_cacertfile /etc/ssl/certs/ca-bundle.crt

# Filters tuned for LLDAP + POSIX
filter passwd (&(objectClass=posixAccount)(uid=*))
filter group  (&(objectClass=posixGroup)(cn=*))

map passwd uidNumber uidNumber
map passwd gidNumber gidNumber
map passwd homeDirectory homeDirectory
map passwd loginShell loginShell

map group gidNumber gidNumber
