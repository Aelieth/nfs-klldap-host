#!/bin/bash
#
# ganesha-ctl - DBUS-free management helper for NFS-Ganesha (self-contained mode).
#
# This script is the supported way to inspect and manage exports from inside
# the container (or via `docker exec` / `podman exec` from the host).
#
# Because we no longer rely on DBUS (required for locked-down environments
# such as ZimaOS where the host DBUS socket cannot be mounted), the old
# org.ganesha.nfsd.exportmgr calls are gone.
#
# Instead:
#   - The source of truth is the directory /etc/ganesha/exports.d/
#   - Any *.conf file containing one or more EXPORT {} blocks is loaded
#   - Changes to exports.d/ (or SIGHUP / ganesha-ctl reload) cause the
#     entrypoint to restart ganesha.nfsd so the new config is picked up.
#   - No dedicated ganesha-export-watcher binary is shipped or needed.
#
# Commands:
#   add-export <file> [name]     - Deprecated / no-op.
#                                  Just place the file in the bind-mounted exports.d/
#                                  directory; the container supervisor will reload.
#   remove-export <name-or-id>   - Best-effort removal: delete the matching
#                                  fragment file (e.g. "10-myshare" or "myshare").
#   show-exports                 - List all current export fragments (the real state).
#   reload                       - Force an immediate restart of ganesha.nfsd
#                                  so it re-reads exports.d/.
#
# Typical interactive use from the host:
#   docker exec alma-nfs-kerb ganesha-ctl show-exports
#   docker exec alma-nfs-kerb ganesha-ctl reload
#
# The management tool (Rust) normally just writes files into the bind-mounted
# exports.d directory. The container takes care of the rest.
#

set -euo pipefail

EXPORTS_DIR="/etc/ganesha/exports.d"

log() {
    echo "[ganesha-ctl] $*"
}

die() {
    echo "[ganesha-ctl] ERROR: $*" >&2
    exit 1
}

usage() {
    cat <<EOF
ganesha-ctl - NFS-Ganesha management helper (DBUS-free / self-contained)

Usage:
  ganesha-ctl add-export <file> [name]     # (no-op, watcher-driven)
  ganesha-ctl remove-export <name-or-id>   # delete matching fragment
  ganesha-ctl show-exports                 # list current exports.d/*.conf
  ganesha-ctl reload                       # restart ganesha to pick up changes

The container watches exports.d/ internally using inotify and restarts
ganesha.nfsd automatically when fragments are added, changed, or removed.
No host DBUS socket is required.
EOF
}

# Best-effort mapping from a user-supplied name/id to a fragment filename.
# Accepts things like "10-myshare", "myshare", "project-alpha", or even an old numeric ID.
resolve_fragment() {
    local name="$1"
    local candidate

    # Direct filename match
    for ext in conf cfg; do
        candidate="${EXPORTS_DIR}/${name}.${ext}"
        if [ -f "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done

    # Try with numeric prefix stripped (common pattern: 10-myshare.conf)
    for f in "${EXPORTS_DIR}"/*.conf "${EXPORTS_DIR}"/*.cfg; do
        [ -f "$f" ] || continue
        base=$(basename "$f" | sed 's/\.[^.]*$//')
        if [ "$base" = "$name" ] || [[ "$base" == *"-${name}" ]] || [[ "$base" == *"${name}" ]]; then
            echo "$f"
            return 0
        fi
    done

    # Last resort: try to find any file whose content mentions the name as Path or Pseudo
    for f in "${EXPORTS_DIR}"/*.conf "${EXPORTS_DIR}"/*.cfg; do
        [ -f "$f" ] || continue
        if grep -qE "(Path|Pseudo)\s*=\s*[^;]*${name}" "$f" 2>/dev/null; then
            echo "$f"
            return 0
        fi
    done

    echo ""
}

CMD="${1:-}"
shift || true

case "$CMD" in
    add-export)
        # In the self-contained world this is mostly a no-op.
        # The management tool (or admin) is expected to write the file directly
        # into the bind-mounted exports.d directory. The watcher will notice.
        FILE="${1:-}"
        NAME="${2:-}"

        if [ -z "$FILE" ]; then
            die "Usage: ganesha-ctl add-export <file-in-exports.d> [name]"
        fi

        if [ ! -f "$FILE" ]; then
            # Allow calling with just a basename; look it up in exports.d
            if [ -f "${EXPORTS_DIR}/$(basename "$FILE")" ]; then
                FILE="${EXPORTS_DIR}/$(basename "$FILE")"
            else
                die "Fragment file not found: $FILE (did you write it into ${EXPORTS_DIR}?)"
            fi
        fi

        log "add-export received for $FILE"
        log "In self-contained mode the container supervisor will pick this up (via inotify + restart)."
        log "If you just wrote the file from outside, the change should already be processing."
        log "You can force an immediate reload with: ganesha-ctl reload"
        ;;

    remove-export)
        # Best effort: delete the fragment file that matches the given name or old ID.
        TARGET="${1:-}"

        if [ -z "$TARGET" ]; then
            die "Usage: ganesha-ctl remove-export <name-or-fragment>"
        fi

        FRAG=$(resolve_fragment "$TARGET")

        if [ -z "$FRAG" ] || [ ! -f "$FRAG" ]; then
            log "No fragment found matching '$TARGET' under ${EXPORTS_DIR}"
            log "Nothing to remove. Current fragments:"
            ls -1 "${EXPORTS_DIR}"/*.conf "${EXPORTS_DIR}"/*.cfg 2>/dev/null || echo "  (directory empty)"
            exit 0
        fi

        log "Removing fragment: $FRAG"
        rm -f "$FRAG" || die "Failed to remove $FRAG"

        log "Fragment removed. Triggering reload so ganesha drops the export..."
        pkill -TERM ganesha.nfsd 2>/dev/null || true
        log "Done. ganesha will restart and the export will be gone."
        ;;

    show-exports)
        log "Current export fragments in ${EXPORTS_DIR}:"

        shopt -s nullglob
        files=( "${EXPORTS_DIR}"/*.conf "${EXPORTS_DIR}"/*.cfg )
        shopt -u nullglob

        if [ ${#files[@]} -eq 0 ]; then
            echo "  (no export fragments found)"
            exit 0
        fi

        for f in "${files[@]}"; do
            echo ""
            echo "=== $(basename "$f") ==="
            # Show the file with line numbers for easy reading
            cat -n "$f"
        done
        echo ""
        log "These fragments are the source of truth. Ganesha is (re)started by the internal watcher when they change."
        ;;

    reload)
        log "Requesting immediate Ganesha restart (self-contained mode)..."
        # In this image we use a simple pkill + restart model driven by the
        # entrypoint. There is no separate ganesha-export-watcher binary.
        pkill -TERM ganesha.nfsd 2>/dev/null || true
        log "Reload triggered. The container supervisor will restart ganesha.nfsd."
        ;;

    *)
        usage
        exit 1
        ;;
esac

