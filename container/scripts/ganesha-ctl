#!/bin/bash
# Ganesha helper (show-exports/reload/remove via inotify + SIGHUP to supervisor).
# The container provides a system bus (dbus-daemon) for Ganesha's own use, but this
# helper (and the supervisor) manage exports/reloads via fragments + HUP (no DBUS RPCs to ganesha).
# See container/README.md. Writes go to exports.d/; supervisor + watcher handle reloads.
# add-export is deprecated/no-op.
#

set -euo pipefail

EXPORTS_DIR="/etc/ganesha/exports.d"

log() {
    echo "[ganesha-ctl] $*"
}

die() {
    echo "[ganesha-ctl] ERROR: $*" >&2
    exit 1
}

usage() {
    cat <<EOF
ganesha-ctl - NFS-Ganesha helper (inotify + supervisor HUP; container bus is for Ganesha internals)

Usage:
  add-export <file> [name]   # (no-op / deprecated; watcher-driven)
  remove-export <name>       # delete matching fragment
  show-exports               # list exports.d
  reload                     # bounce ganesha via supervisor

Container watches config/exports.d; supervisor bounces on change.
EOF
}

# Best-effort mapping from a user-supplied name/id to a fragment filename.
# Accepts things like "10-myshare", "myshare", "project-alpha", or even an old numeric ID.
resolve_fragment() {
    local name="$1"
    local candidate

    # Direct filename match
    for ext in conf cfg; do
        candidate="${EXPORTS_DIR}/${name}.${ext}"
        if [ -f "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done

    # Try with numeric prefix stripped (common pattern: 10-myshare.conf)
    for f in "${EXPORTS_DIR}"/*.conf "${EXPORTS_DIR}"/*.cfg; do
        [ -f "$f" ] || continue
        base=$(basename "$f" | sed 's/\.[^.]*$//')
        if [ "$base" = "$name" ] || [[ "$base" == *"-${name}" ]] || [[ "$base" == *"${name}" ]]; then
            echo "$f"
            return 0
        fi
    done

    # Last resort: try to find any file whose content mentions the name as Path or Pseudo
    for f in "${EXPORTS_DIR}"/*.conf "${EXPORTS_DIR}"/*.cfg; do
        [ -f "$f" ] || continue
        if grep -qE "(Path|Pseudo)\s*=\s*[^;]*${name}" "$f" 2>/dev/null; then
            echo "$f"
            return 0
        fi
    done

    echo ""
}

CMD="${1:-}"
shift || true

case "$CMD" in
    add-export)
        # Deprecated/no-op: write directly to bind-mounted exports.d; watcher + supervisor pick up.
        FILE="${1:-}"
        if [ -z "$FILE" ]; then
            die "Usage: ganesha-ctl add-export <file-in-exports.d> [name]"
        fi
        if [ ! -f "$FILE" ]; then
            if [ -f "${EXPORTS_DIR}/$(basename "$FILE")" ]; then
                FILE="${EXPORTS_DIR}/$(basename "$FILE")"
            else
                die "Fragment file not found: $FILE (write it into ${EXPORTS_DIR})"
            fi
        fi
        log "add-export (no-op): $FILE will be picked up by watcher + HUP"
        ;;

    remove-export)
        # Best effort: delete the fragment file that matches the given name or old ID.
        TARGET="${1:-}"

        if [ -z "$TARGET" ]; then
            die "Usage: ganesha-ctl remove-export <name-or-fragment>"
        fi

        FRAG=$(resolve_fragment "$TARGET")

        if [ -z "$FRAG" ] || [ ! -f "$FRAG" ]; then
            log "No fragment found matching '$TARGET' under ${EXPORTS_DIR}"
            log "Nothing to remove. Current fragments:"
            ls -1 "${EXPORTS_DIR}"/*.conf "${EXPORTS_DIR}"/*.cfg 2>/dev/null || echo "  (directory empty)"
            exit 0
        fi

        log "Removing fragment: $FRAG"
        rm -f "$FRAG" || die "Failed to remove $FRAG"

        log "Fragment removed. Triggering reload so ganesha drops the export..."
        pkill -TERM ganesha.nfsd 2>/dev/null || true
        log "Done. ganesha will restart and the export will be gone."
        ;;

    show-exports)
        log "Current export fragments in ${EXPORTS_DIR}:"

        shopt -s nullglob
        files=( "${EXPORTS_DIR}"/*.conf "${EXPORTS_DIR}"/*.cfg )
        shopt -u nullglob

        if [ ${#files[@]} -eq 0 ]; then
            echo "  (no export fragments found)"
            exit 0
        fi

        for f in "${files[@]}"; do
            echo ""
            echo "=== $(basename "$f") ==="
            # Show the file with line numbers for easy reading
            cat -n "$f"
        done
        echo ""
        log "These fragments are the source of truth. Ganesha is (re)started by the internal watcher when they change."
        ;;

    reload)
        log "Requesting Ganesha restart (self-contained)..."
        # Supervisor HUP does pkill + respawn (SSSD/WebUI too for full apply).
        # (The container now has a system bus; this path does not use DBUS for management.)
        pkill -TERM ganesha.nfsd 2>/dev/null || true
        log "Reload triggered (supervisor will respawn)."
        ;;

    *)
        usage
        exit 1
        ;;
esac

