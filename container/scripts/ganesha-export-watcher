#!/bin/bash
#
# ganesha-export-watcher - Self-contained Ganesha export reload handler (NO DBUS).
#
# This script is the key to running on locked-down platforms (ZimaOS and similar)
# where the host DBUS socket cannot be mounted into the container.
#
# The management tool (or admin) writes EXPORT {} fragments into the
# bind-mounted /etc/ganesha/exports.d/. This watcher detects the change
# using inotify and restarts ganesha.nfsd (the supervisor loop in entrypoint
# brings it back immediately). The container truly "takes care of itself".
#
# Modes:
#   (no args)   - Run forever watching for changes (started by entrypoint)
#   reload      - One-shot trigger: cause an immediate ganesha restart
#
set -euo pipefail

EXPORTS_DIR="/etc/ganesha/exports.d"
DEBOUNCE="${WATCHER_DEBOUNCE_SECONDS:-2}"

log() { echo "[ganesha-export-watcher] $*"; }

if ! command -v inotifywait >/dev/null 2>&1; then
    echo "[ganesha-export-watcher] FATAL: inotifywait not found (install inotify-tools)" >&2
    exit 1
fi

do_reload() {
    log "Reload requested - terminating ganesha.nfsd so supervisor restarts it with fresh exports..."
    pkill -TERM ganesha.nfsd 2>/dev/null || true
}

run_watcher() {
    mkdir -p "$EXPORTS_DIR"
    log "Watching ${EXPORTS_DIR} for changes (debounce ${DEBOUNCE}s). Ganesha will be restarted automatically."
    while true; do
        if inotifywait -q -r -m -e create,modify,delete,move --format '%e %w%f' "$EXPORTS_DIR" 2>/dev/null | \
           while read -r ev path; do
               if [[ "$path" == *.conf ]]; then
                   log "Change detected: $ev $path"
                   sleep "$DEBOUNCE"
                   pkill -TERM ganesha.nfsd 2>/dev/null || true
                   log "Triggered ganesha restart (new exports loaded on next start)."
                   sleep 1
               fi
           done
        then
            :
        else
            log "inotifywait error, retrying..."
            sleep 3
        fi
    done
}

case "${1:-}" in
    reload) do_reload ;;
    -h|--help)
        echo "ganesha-export-watcher [reload]"
        echo "  No args: run continuous watcher (normal operation)"
        echo "  reload : trigger immediate ganesha restart"
        ;;
    *) run_watcher ;;
esac
