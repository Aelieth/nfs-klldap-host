#!/bin/bash
# inotify watcher on nfs-klldap.conf; SIGHUPs pid 1 for the graceful scoped
# apply (Ganesha export reread + WebUI in-place refresh; identity changes are
# staged until a forced full recycle). Signaling pid 1 also guarantees the
# privileged 0600 sssd.conf regeneration. See container/README.md.
set -euo pipefail

CONFIG_PATH="${1:-${NFS_CONFIG:-/config/nfs-klldap.conf}}"
DEBOUNCE="${WATCHER_DEBOUNCE_SECONDS:-2}"
CONFIG_BIN="/usr/local/bin/nfs-klldap-config"

log() { echo "[nfs-klldap-conf-watcher] $*"; }

if [ ! -f "$CONFIG_PATH" ]; then
    log "WARNING: Config file $CONFIG_PATH does not exist yet. Watching anyway..."
fi

if ! command -v inotifywait >/dev/null 2>&1; then
    log "FATAL: inotifywait not found (install inotify-tools)"
    exit 1
fi

if [ ! -x "$CONFIG_BIN" ]; then
    log "FATAL: $CONFIG_BIN not found or not executable"
    exit 1
fi

log "Watching $CONFIG_PATH for changes (debounce ${DEBOUNCE}s)"

while true; do
    if inotifywait -q -e modify,move,create,delete "$CONFIG_PATH" 2>/dev/null; then
        log "Change detected on $CONFIG_PATH"
        sleep "$DEBOUNCE"

        # Ask the root supervisor (pid 1) to perform the privileged regeneration.
        # This guarantees that /etc/sssd/sssd.conf is always written as root:root 0600,
        # satisfying SSSD's strict internal access_check_file() ownership requirement.
        # The supervisor then applies a scoped graceful reload: Ganesha rereads
        # exports, the WebUI refreshes in place, and identity changes stay
        # staged until 'Restart and apply' runs the forced full recycle.
        if kill -HUP 1 2>/dev/null; then
            log "Signaled supervisor (pid 1) for privileged regeneration + reload"
        else
            log "WARNING: Could not signal pid 1; falling back to direct (may fail for sssd.conf ownership)"
            if "$CONFIG_BIN" generate --config "$CONFIG_PATH"; then
                log "Regenerated configs (direct, as current user)"
            else
                log "ERROR: Generator failed for $CONFIG_PATH (see above for details from the binary)"
            fi
        fi
    else
        log "inotifywait error, retrying in 3s..."
        sleep 3
    fi
done
