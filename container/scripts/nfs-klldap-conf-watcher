#!/bin/bash
#
# nfs-klldap-conf-watcher - Watches the central nfs-klldap.conf and triggers
# privileged regeneration of derived configs (sssd.conf, krb5.conf, ganesha
# exports) plus daemon reloads.
#
# The watcher runs as root and signals the root supervisor (pid 1)
# supervisor (pid 1) so that /etc/sssd/sssd.conf is always written with the
# root:root 0600 ownership that modern SSSD strictly requires.
#
# This is the recommended way to get automatic reload when the host UI (or
# an admin) edits the single source-of-truth config file.
#
# Usage:
#   nfs-klldap-conf-watcher [path-to-config]
#
# Environment:
#   NFS_CONFIG          - fallback config path
#   WATCHER_DEBOUNCE_SECONDS (default 2)
#
set -euo pipefail

CONFIG_PATH="${1:-${NFS_CONFIG:-/config/nfs-klldap.conf}}"
DEBOUNCE="${WATCHER_DEBOUNCE_SECONDS:-2}"
CONFIG_BIN="/usr/local/bin/nfs-klldap-config"

log() { echo "[nfs-klldap-conf-watcher] $*"; }

if [ ! -f "$CONFIG_PATH" ]; then
    log "WARNING: Config file $CONFIG_PATH does not exist yet. Watching anyway..."
fi

if ! command -v inotifywait >/dev/null 2>&1; then
    log "FATAL: inotifywait not found (install inotify-tools)"
    exit 1
fi

if [ ! -x "$CONFIG_BIN" ]; then
    log "FATAL: $CONFIG_BIN not found or not executable"
    exit 1
fi

log "Watching $CONFIG_PATH for changes (debounce ${DEBOUNCE}s)"

while true; do
    if inotifywait -q -e modify,move,create,delete "$CONFIG_PATH" 2>/dev/null; then
        log "Change detected on $CONFIG_PATH"
        sleep "$DEBOUNCE"

        # Ask the root supervisor (pid 1) to perform the privileged regeneration.
        # This guarantees that /etc/sssd/sssd.conf is always written as root:root 0600,
        # satisfying SSSD's strict internal access_check_file() ownership requirement.
        # The supervisor will also fix other perms and restart/reload the daemons.
        if kill -HUP 1 2>/dev/null; then
            log "Signaled supervisor (pid 1) for privileged regeneration + reload"
        else
            log "WARNING: Could not signal pid 1; falling back to direct (may fail for sssd.conf ownership)"
            if "$CONFIG_BIN" generate --config "$CONFIG_PATH"; then
                log "Regenerated configs (direct, as current user)"
            else
                log "ERROR: Generator failed for $CONFIG_PATH"
            fi
        fi

        # Ganesha-ctl / pkill will be handled inside the supervisor's SIGHUP handler.
        # We still give ganesha an extra prod in case the supervisor path is slow.
        if command -v /usr/local/bin/ganesha-ctl >/dev/null 2>&1; then
            /usr/local/bin/ganesha-ctl reload || true
        else
            pkill -HUP ganesha.nfsd 2>/dev/null || true
        fi
    else
        log "inotifywait error, retrying in 3s..."
        sleep 3
    fi
done
