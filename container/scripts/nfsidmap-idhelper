#!/bin/bash
# nfsidmap-idhelper shim for nfs-klldap-host (ganesha 9.6 / Debian trixie specific)
#
# Purpose: Make the server perform the *same* principal-to-uid/gid lookup that
# clients expect (getent + idhelper classification for testuser1@REALM and
# host/CLIENT@REALM). Ganesha's principal2uid code path execs "nfsidmap" (see
# ganesha.log: "Get uid for ... using nfsidmap").
#
# This script (installed as /usr/local/bin/nfsidmap-idhelper) is made visible
# as the literal name 'nfsidmap' via symlink in the ganesha PATH prefix
# (see Dockerfile + entrypoint.sh). This ensures that when Ganesha does
# "Get uid for <principal> using nfsidmap", our wrapper is found first.
# On hit (via idhelper) it returns the numeric id exactly as nfsidmap would.
# On miss it transparently falls back to the real /usr/sbin/nfsidmap.
#
# Only safe, documented 9.x behavior. No new Ganesha config options.
#
# Usage (as invoked by Ganesha idmapper):
#   nfsidmap -u user@REALM
#   nfsidmap -g user@REALM
# Output on success: decimal uid (or gid) on stdout, exit 0.
#
# Install: copied by Dockerfile; entrypoint launches ganesha with PATH override.
#
# 0.8.32 note: The idhelper now routes getent + principal resolution through the
# structured LDAP capabilities + caches (see nfs-klldap-config/src/idmap.rs and
# integration in the idhelper binary). This gives cache hits and parity with the
# UI LdapClient. The shim remains required for ganesha 9.6/trixie-backports because
# the ID MAPPER code path still execs the literal "nfsidmap" binary for some
# principal2uid cases (visible in ganesha.log). When Ganesha or future config
# makes the external path unnecessary the shim + PATH mangling can be removed
# (the nss_wrapper/extrausers materialization + getent will be sufficient).
# Retain the shim for strict Debian trixie + backported ganesha 9.6 compatibility.
set -euo pipefail

IDHELPER="${IDHELPER_BIN:-/usr/local/bin/nfs-klldap-idhelper}"
# Locate the *real* system nfsidmap for fallback (after our resolve attempt).
# We overrode /usr/sbin/nfsidmap and /usr/local/bin/nfsidmap with symlinks to this script.
# Always prefer the .system backup we created at install time.
# Use readlink -f + explicit exclusion so we never recurse into ourselves even if
# PATH or command -v would return one of our symlinks.
REAL_NFSIDMAP=""
for cand in /usr/sbin/nfsidmap.system /usr/local/bin/nfsidmap.system /usr/sbin/nfsidmap.real; do
    if [ -x "$cand" ]; then
        rp=$(readlink -f "$cand" 2>/dev/null || echo "$cand")
        if ! echo "$rp" | grep -qi 'nfsidmap-idhelper\|/usr/local/bin/nfsidmap$\|/usr/sbin/nfsidmap$'; then
            REAL_NFSIDMAP="$cand"
            break
        fi
    fi
done
if [ -z "$REAL_NFSIDMAP" ]; then
    # Dynamic but filtered
    dyn=$(command -v nfsidmap 2>/dev/null | head -1 || true)
    if [ -n "$dyn" ]; then
        rp=$(readlink -f "$dyn" 2>/dev/null || echo "$dyn")
        if echo "$rp" | grep -qi 'nfsidmap-idhelper\|/usr/local/bin/nfsidmap$\|/usr/sbin/nfsidmap$'; then
            dyn=""
        fi
    fi
    REAL_NFSIDMAP="${dyn:-/usr/sbin/nfsidmap}"
fi

log() {
    # Only when debugging the shim (not normal op)
    if [ "${NFSIDMAP_IDHELPER_DEBUG:-0}" = "1" ]; then
        echo "[nfsidmap-idhelper] $*" >&2
    fi
}

# Minimal arg parsing for the forms Ganesha uses in the observed logs.
# -u <name> or --user <name> for uid
# -g <name> or --group <name> for gid
# Also tolerate bare "principal" in some older call styles.
mode="uid"
principal=""

while [ $# -gt 0 ]; do
    case "$1" in
        -u|--user)
            mode="uid"
            shift
            if [ $# -gt 0 ]; then principal="$1"; fi
            ;;
        -g|--group)
            mode="gid"
            shift
            if [ $# -gt 0 ]; then principal="$1"; fi
            ;;
        -c|--clear|-C|--clear-all)
            # Passthrough for cache ops; do not interfere.
            exec "$REAL_NFSIDMAP" "$@"
            ;;
        -*)
            # Unknown flag: let the real tool handle (or fail)
            exec "$REAL_NFSIDMAP" "$@"
            ;;
        *)
            # Bare arg is often the principal in simple calls.
            if [ -z "$principal" ]; then
                principal="$1"
            fi
            ;;
    esac
    shift
done

if [ -z "$principal" ]; then
    # Nothing useful; delegate
    exec "$REAL_NFSIDMAP" "$@"
fi

log "lookup mode=$mode principal=$principal"

if [ -x "$IDHELPER" ]; then
    # Always attempt our resolve first. This has the critical side-effect of
    # classifying + materializing into nss_wrapper/extrausers (and IdCache) so that
    # Ganesha's getpwnam / subsequent cred paths see the mapping even if this
    # particular call is for a principal that has never been seen before.
    # We try --json, then fall back to plain text output for parsing (more tolerant).
    resolved_uid=""
    resolved_gid=""

    if json="$($IDHELPER resolve "$principal" --json 2>/dev/null || true)"; then
        if [ -n "$json" ]; then
            if [ "$mode" = "uid" ]; then
                resolved_uid=$(printf '%s' "$json" | sed -n 's/.*"uid":\([0-9][0-9]*\).*/\1/p' | head -1)
            else
                resolved_gid=$(printf '%s' "$json" | sed -n 's/.*"gid":\([0-9][0-9]*\).*/\1/p' | head -1)
            fi
        fi
    fi

    # Text fallback (the non-json "resolve" output contains "uid=NNN" / "gid=NNN")
    if [ -z "$resolved_uid" ] && [ -z "$resolved_gid" ]; then
        txt="$($IDHELPER resolve "$principal" 2>/dev/null || true)"
        if [ -n "$txt" ]; then
            if [ "$mode" = "uid" ]; then
                resolved_uid=$(printf '%s' "$txt" | grep -o 'uid=[0-9]*' | head -1 | cut -d= -f2)
            else
                resolved_gid=$(printf '%s' "$txt" | grep -o 'gid=[0-9]*' | head -1 | cut -d= -f2)
            fi
        fi
    fi

    if [ "$mode" = "uid" ] && [ -n "$resolved_uid" ]; then
        log "resolved via idhelper -> uid=$resolved_uid"
        printf '%s\n' "$resolved_uid"
        exit 0
    fi
    if [ "$mode" = "gid" ] && [ -n "$resolved_gid" ]; then
        log "resolved via idhelper -> gid=$resolved_gid"
        printf '%s\n' "$resolved_gid"
        exit 0
    fi

    # For user principals (contain @ and not an obvious machine service), do a short
    # retry. This gives any concurrent observer, sss population, or previous
    # materialize a moment to become visible to a follow-up resolve call.
    # Cheap on cache hit; helps win the race for the first principal2uid in a compound.
    if [ -n "$principal" ] && echo "$principal" | grep -q '@' && ! echo "$principal" | grep -qiE '^(host| nfs|root)/'; then
        if [ "$mode" = "uid" ] && [ -z "$resolved_uid" ]; then
            sleep 0.15
            if json2="$($IDHELPER resolve "$principal" --json 2>/dev/null || true)"; then
                resolved_uid=$(printf '%s' "$json2" | sed -n 's/.*"uid":\([0-9][0-9]*\).*/\1/p' | head -1)
            fi
            if [ -z "$resolved_uid" ]; then
                txt2="$($IDHELPER resolve "$principal" 2>/dev/null || true)"
                resolved_uid=$(printf '%s' "$txt2" | grep -o 'uid=[0-9]*' | head -1 | cut -d= -f2)
            fi
            if [ -n "$resolved_uid" ]; then
                log "resolved via idhelper (retry) -> uid=$resolved_uid"
                printf '%s\n' "$resolved_uid"
                exit 0
            fi
        fi
        # similar for gid if needed (omitted for brevity; uid is the hot path for ACCESS)
    fi
fi

# Fallback: real nfsidmap (may use sss/winbind/nfsidmapd paths)
log "falling back to $REAL_NFSIDMAP"
exec "$REAL_NFSIDMAP" "$@"
