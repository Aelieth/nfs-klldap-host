#!/bin/bash
#
# webui-certs - Prepare TLS certificates for the in-container WebUI on port 9630.
#
# This script is now primarily responsible for discovering *user-provided*
# certificates in the config directory. Self-signed certificate generation
# has moved into the Rust binary (using rcgen) for better testability and
# reliability. See nfs-klldap-ui/src/certs.rs and container/README.md.
#
# Behavior:
#   1. Looks for custom certificates in the same directory as nfs-klldap.conf:
#        - webui.crt + webui.key   OR
#        - tls.crt + tls.key
#   2. If found, symlinks them into the standard location /var/run/webui-certs/
#   3. If not found, does NOT generate. It simply ensures the target directory
#      exists and outputs the standard paths.
#
# Self-signed certificate generation (when no custom certs are provided) is now
# performed inside the Rust binary using rcgen. See nfs-klldap-ui/src/certs.rs
# (function ensure_webui_tls_certs).
#
# The resulting paths are emitted as WEBUI_TLS_CERT / WEBUI_TLS_KEY for the
# WebUI binary. The Rust side guarantees valid files will exist before binding.
#
set -euo pipefail

CERT_DIR="/var/run/webui-certs"

# Determine config directory from the most common environment variables
# used by the rest of the container (NFS_CONFIG takes precedence).
if [ -n "${NFS_CONFIG:-}" ]; then
    CONFIG_DIR="$(dirname "$NFS_CONFIG")"
else
    CONFIG_DIR="${NFS_CONFIG_DIR:-/config}"
fi

mkdir -p "$CERT_DIR"

CUSTOM_CERT=""
CUSTOM_KEY=""

# Check for custom certificates (support two common naming conventions)
for prefix in webui tls; do
    crt="${CONFIG_DIR}/${prefix}.crt"
    key="${CONFIG_DIR}/${prefix}.key"
    if [[ -f "$crt" && -f "$key" ]]; then
        CUSTOM_CERT="$crt"
        CUSTOM_KEY="$key"
        break
    fi
done

if [[ -n "$CUSTOM_CERT" ]]; then
    echo "[webui-certs] Using custom certificates from ${CONFIG_DIR}" >&2
    ln -sf "$CUSTOM_CERT" "$CERT_DIR/webui.crt" || true
    ln -sf "$CUSTOM_KEY" "$CERT_DIR/webui.key" || true
    chmod 600 "$CERT_DIR/webui.key" || true
else
    echo "[webui-certs] No custom certificates found in ${CONFIG_DIR}. The Rust binary will generate self-signed certs if needed." >&2
    # Do not generate here anymore — generation has moved into the Rust binary
    # (nfs-klldap-ui) using rcgen for better testability and reliability.
    # We still ensure the target directory exists.
    mkdir -p "$CERT_DIR"
fi

# Always output the standard paths. The Rust side (ensure_webui_tls_certs)
# will generate self-signed material into these locations if the files
# do not exist (for the custom-cert case they will have been symlinked above).
echo "WEBUI_TLS_CERT=${CERT_DIR}/webui.crt"
echo "WEBUI_TLS_KEY=${CERT_DIR}/webui.key"