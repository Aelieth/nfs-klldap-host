# NFS-Ganesha configuration (rendered from ganesha.conf.template)
#
# This is the primary configuration for the alma_nfs-kerb "one stop NFS plugin".
#
# Philosophy:
# - Ganesha is the complete user-space NFSv4 + Kerberos server.
# - The management tool on the host writes native Ganesha EXPORT {} blocks
#   into the bind-mounted /etc/ganesha/exports.d/ directory.
# - This file includes them via %include (glob supported in Ganesha 7+).
# - The management tool can also speak directly to Ganesha at runtime
#   using: docker exec <container> ganesha-ctl add-export ...
#   The container's internal ganesha-export-watcher (inotify) detects changes
#   to this directory and restarts ganesha.nfsd so the new exports are loaded.
#
# No kernel NFS modules are required on the host.
#
# Customize by bind-mounting your own templates directory or by
# bind-mounting a final /etc/ganesha/ganesha.conf directly.

NFS_CORE_PARAM {
    # NFSv4 only (recommended for this project; v3 can be added if truly needed)
    Protocols = 4;

    # No DBUS management interface is used.
    # Export changes are handled entirely by the container's internal
    # ganesha-export-watcher (inotify + supervisor restart loop).
}

NFSv4 {
    # Must match your Kerberos realm (and usually your DNS domain)
    DomainName = ${REALM:-EXAMPLE.COM};

    # Minor versions: 4.0, 4.1, 4.2 are all useful.
    # 4.1/4.2 bring pNFS, sessions, etc. Leave enabled.
    Minor_Versions = 0, 1, 2;

    # Lease time (seconds). 60-120 is common.
    Lease_Lifetime = 60;
}

NFS_KRB5 {
    # The service principal that Ganesha will use.
    # This must exist in the keytab mounted at /etc/krb5.keytab.
    # The instance must match the container (and host) hostname.
    PrincipalName = nfs/${HOSTNAME}@${REALM:-EXAMPLE.COM};

    # Allow both krb5 and krb5p (integrity+privacy). krb5p is strongly preferred.
    # Clients can choose sec=krb5p (or krb5i, krb5) at mount time.
}

EXPORT_DEFAULTS {
    # Strong authentication + privacy by default.
    # Clients that mount with sec=krb5p will get full GSS integrity+privacy.
    SecType = krb5p;

    # Default access. Individual EXPORTs or CLIENT blocks can tighten this.
    Access_Type = RW;

    # Protocols for this export (inherit from NFS_CORE_PARAM unless overridden)
    Protocols = 4;

    # Let the local system (SSSD + LLDAP) provide UID/GID resolution.
    # Ganesha will use nsswitch for name<->id mapping when needed.
    # Squash = No_Root_Squash;   # usually not needed with Kerberos + proper POSIX

    # FSAL defaults (VFS for local bind-mounted host directories)
    FSAL {
        Name = VFS;
    }
}

# -----------------------------------------------------------------------------
# Dynamic exports
#
# The management tool (and/or manual admin) drops files containing
# EXPORT { ... } blocks into this directory.
#
# Each file should be named something like:
#   10-projectalpha.conf
#   20-backups.conf
#
# Ganesha will include them at startup.
#
# For runtime add/remove (no restart), the management tool calls:
#   docker exec <container> ganesha-ctl add-export /etc/ganesha/exports.d/10-xxx.conf "EXPORT(Path=/...)"
#   docker exec <container> ganesha-ctl remove-export <export_id>
#
# The ganesha-ctl helper is now file-based (show-exports lists fragments,
# remove-export deletes them). The watcher handles reloads. No DBUS.
# -----------------------------------------------------------------------------
%include "/etc/ganesha/exports.d/*.conf"

# -----------------------------------------------------------------------------
# Logging (tune for production vs troubleshooting)
# -----------------------------------------------------------------------------
LOG {
    # Default_Log_Level = EVENT;     # normal operations
    # Default_Log_Level = DEBUG;     # noisy but very useful when setting up
    # Components { NFS_V4 = DEBUG; KRB5 = DEBUG; FSAL = EVENT; }
}

# -----------------------------------------------------------------------------
# Example of a static export (you can put these here or in exports.d/)
#
# Most users should let the management tool manage exports.d/.
# This is only for reference / emergency manual exports.
#
