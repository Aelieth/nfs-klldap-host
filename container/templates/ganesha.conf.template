#     Export_Id = 77;
#     Path = /export/manual;
#     Pseudo = /manual;
#     Access_Type = RO;
#     SecType = krb5p;
#     Protocols = 4;
#
#     FSAL {
#         Name = VFS;
#     }
#
#     # Optional: restrict to specific clients / netgroups
#     # CLIENT {
