#
# idmapd.conf.template
#
# Edit this file directly. The container renders it to /etc/idmapd.conf on every start.
#
# See docs/ldap-integration.md for idmapping verification commands.
#

[General]
# Must match your Kerberos realm (and usually your DNS domain)
Domain = EXAMPLE.COM
Local-Realms = EXAMPLE.COM

[Mapping]
Nobody-User = nobody
Nobody-Group = nobody

[Translation]
# Primary choice when using SSSD + sssd-nfs-idmap (recommended on AlmaLinux 10)
Method = sss

# Alternative: fall back to nsswitch (files + ldap or files + sss)
# Method = nsswitch

# You can combine methods if needed
# Method = sss,nsswitch
