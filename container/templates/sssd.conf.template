#
# sssd.conf.template
#
# Edit this file directly. The container renders it to /etc/sssd/sssd.conf on every start.
# Bind-mount the templates directory to customize (see TEMPLATES_DIR env var).
#
# See docs/ldap-integration.md for LLDAP POSIX setup and verification steps.
#

[domain/default]
id_provider = ldap
auth_provider = ldap
access_provider = permit

# LLDAP server (LDAPS on port 6360 is the LLDAP default)
ldap_uri = ldaps://lldap.example.com:6360

# Base DIT for your domain
ldap_search_base = dc=example,dc=com

# LLDAP typically uses ou=people and ou=groups
ldap_user_search_base = ou=people,dc=example,dc=com
ldap_group_search_base = ou=groups,dc=example,dc=com

# Object classes LLDAP uses with POSIX attributes
ldap_user_object_class = inetOrgPerson
ldap_group_object_class = posixGroup

# Attribute mappings for POSIX users/groups
ldap_user_name = uid
ldap_user_uid_number = uidNumber
ldap_user_gid_number = gidNumber
ldap_user_home_directory = homeDirectory
ldap_user_shell = loginShell

ldap_group_name = cn
ldap_group_gid_number = gidNumber
ldap_group_member = memberUid

# TLS settings
ldap_tls_reqcert = demand
# ldap_tls_cacert = /etc/ssl/certs/ca-bundle.crt

# Useful for small environments and NFS idmapping
enumerate = true

# Caching suitable for NFS workloads
cache_credentials = true
ldap_enumeration_refresh_timeout = 300
ldap_purge_cache_timeout = 3600

[sssd]
config_file_version = 2
services = nss, pam
domains = default

# Increase for debugging (0-10)
# debug_level = 7

[nss]
filter_groups = root
filter_users = root
reconnection_retries = 3

[pam]
reconnection_retries = 3
