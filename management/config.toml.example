# =============================================================================
# Example configuration for the NFS Kerb Management Tool
# Copy to config.toml and adjust.
#
# This is the Ganesha-only version. The tool now:
# - Manages native Ganesha EXPORT {} blocks (not classic kernel exports)
# - Writes EXPORT fragments into ganesha_exports_dir. The container's internal
#   ganesha-export-watcher (inotify) detects changes and restarts Ganesha.
#   No DBUS or host socket mount is required (works on ZimaOS and locked-down appliances).
# - Presents a share-centric UI for browsing and setting POSIX permissions
#   on any subdirectory under each share (with LLDAP user/group lookup + recursive apply)
# =============================================================================

# -----------------------------------------------------------------------------
# Security boundary: directories the tool is allowed to touch for chown/chmod.
# The privileged helper will refuse anything outside these roots.
#
# On ZimaOS / locked-down appliances only attached/media drives are used.
# Typical paths look like /media/SSD-01, /media/USB-01, /mnt/disk1, etc.
# System paths such as /srv/nfs do not exist or are not used for exports.
# -----------------------------------------------------------------------------
allowed_roots = [
    "/media/SSD-01",
    "/media/USB-01",
]

# -----------------------------------------------------------------------------
# Privileged helper (does the actual recursive chown/chmod on the host FS)
# -----------------------------------------------------------------------------
helper_path = "/usr/local/bin/nfs-perm-helper"
use_sudo = true   # set false only if the helper is setuid root

# -----------------------------------------------------------------------------
# LLDAP / KLLDAP (your custom fork with Kerberos + POSIX)
# -----------------------------------------------------------------------------
# lldap_graphql_url = "https://lldap.example.com:6360/api/graphql"

# -----------------------------------------------------------------------------
# Ganesha integration (the heart of the "one stop plugin")
# -----------------------------------------------------------------------------

# Name of the running Ganesha container (used for `docker exec` / `podman exec`)
ganesha_container_name = "alma-nfs-kerb"

# Host-side directory that is bind-mounted into the container at
# /etc/ganesha/exports.d/. The tool writes native Ganesha EXPORT {} blocks here.
ganesha_exports_dir = "./ganesha-exports.d"

# -----------------------------------------------------------------------------
# Shares - the primary model (preferred over flat allowed_roots)
#
# Each share becomes:
#   - One top-level Ganesha EXPORT block (written to ganesha_exports_dir)
#   - A browsable directory tree in the management UI
#   - A place where you can click *any* subfolder and change its POSIX owner/group/mode
#     (with live LLDAP lookup + recursive apply via the privileged helper)
#
# The host_path must exist on the Docker host and be bind-mounted into the
# NFS container at the corresponding container path.
# -----------------------------------------------------------------------------
# All shares come from attached/media drives.
# The paths below are realistic for a ZimaOS-style environment.
[[shares]]
name = "project-alpha"
host_path = "/media/SSD-01/project-alpha"
export_path = "/project-alpha"
export_id = 1001

[[shares]]
name = "backups"
host_path = "/media/SSD-01/backups"
export_path = "/backups"
export_id = 1002

# Add more shares as needed (all from attached drives).
# Each one appears in the UI as its own top-level item with its own
# expandable directory tree underneath.
